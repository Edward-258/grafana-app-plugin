{
  "name": "local-ecs-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --env production && npm run build:backend",
    "build:frontend": "webpack --env production",
    "build:backend": "PATH=\"$HOME/.local/go/bin:$HOME/go/bin:$PATH\" CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags='-s -w' -o dist/gpx_ecs_linux_amd64 ./pkg",
    "dev": "webpack -w --env development",
    "server": "docker compose up"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "11.5.0",
    "@grafana/runtime": "11.5.0",
    "@grafana/ui": "11.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@types/react": "^18.3.0",
    "copy-webpack-plugin": "^12.0.2",
    "swc-loader": "^0.2.6",
    "typescript": "^5.7.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}

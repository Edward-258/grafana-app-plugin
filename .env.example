# .env 模板：复制为 .env 并填入真实值（.env 已入 .gitignore，绝不入库）
#   cp .env.example .env
#
# GF_SECURITY_SECRET_KEY —— Grafana 加密 grafana.db 中 secure_json_data（AK/SK）的密钥。
# 不设置时 Grafana 使用公开的内置默认密钥：拿到 grafana.db 的人即可解出 AK/SK。
# 生成：openssl rand -base64 48
# 注意：更换此值后，旧密文无法解密，需在插件配置页重录一次 AK/SK。
# CI（GitHub Actions）无 .env，走默认空值，临时容器不落敏感数据，无影响。
GF_SECURITY_SECRET_KEY=
